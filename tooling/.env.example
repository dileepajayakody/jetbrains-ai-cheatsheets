# Copy to `.env` and fill in. The .env file is git-ignored.
# Only the extract stage uses these; crawl and render need no secrets.

# Claude via Amazon Bedrock — a Bedrock API key (bearer token) is simplest:
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Optional model override (default: global.anthropic.claude-sonnet-4-6):
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Or use standard AWS credentials instead of a Bedrock API key:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
