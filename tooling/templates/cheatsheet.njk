<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1500">
    <title>{{ displayName }} Cheat Sheet</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        @font-face {
            font-family: 'Modul Air';
            src: url('https://air.dev/fonts/Modul_AirVF.ttf') format('truetype');
            font-display: swap;
        }
        :root {
            --synthetic-green: {{ accent.green | default('#48E054') }};
            --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
            --font-sans: 'Hanken Grotesk', system-ui, -apple-system, sans-serif;
        }
        * { box-sizing: border-box; }
        body { margin: 0; background: #000; }

        .pg {
            background: #000;
            background-image: radial-gradient(rgba(72, 224, 84, .16) 1px, transparent 1.4px);
            background-size: 22px 22px;
            padding: 40px 36px 56px;
            font-family: var(--font-mono);
        }
        .frame { max-width: 1432px; margin: 0 auto; }

        /* ---- header band ---- */
        .hd { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; padding-bottom: 22px; margin-bottom: 26px; border-bottom: 1px solid rgba(255, 255, 255, .75); }
        .hd-l { display: flex; align-items: flex-start; gap: 18px; }
        .mark { width: 46px; height: 46px; flex: none; margin-top: 3px; }
        .eyebrow { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--synthetic-green); margin: 0 0 6px; }
        .title { font-family: var(--font-sans); font-weight: 500; font-size: 40px; line-height: 1; letter-spacing: -.01em; color: #fff; margin: 0; }
        .title .hl, .title .hl2 { color: var(--synthetic-green); }
        .sub { font-family: var(--font-mono); font-size: 12.5px; line-height: 1.5; color: rgba(255, 255, 255, .7); margin: 9px 0 0; max-width: 560px; }
        .hd-r { text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 7px; flex: none; }
        .ver { display: inline-flex; align-items: center; gap: 7px; font-family: var(--font-mono); font-size: 11px; font-weight: 600; color: #000; background: var(--synthetic-green); padding: 4px 10px; }
        .stamp { font-family: var(--font-mono); font-size: 11px; color: rgba(255, 255, 255, .55); letter-spacing: .02em; }
        .stamp b { color: rgba(255, 255, 255, .85); font-weight: 600; }
        .docs { font-family: var(--font-mono); font-size: 11px; font-weight: 600; color: var(--synthetic-green); text-decoration: none; border: 1px solid var(--synthetic-green); padding: 5px 12px; letter-spacing: .02em; }
        .docs:hover { background: var(--synthetic-green); color: #000; }

        /* ---- sheet ---- */
        .sheet { background: #fff; padding: 22px 22px 14px; }
        .grid { column-count: 4; column-gap: 16px; }
        @media (max-width: 1200px) { .grid { column-count: 3; } }
        .card { break-inside: avoid; -webkit-column-break-inside: avoid; border: 1px solid #E5E5E0; margin: 0 0 16px; background: #fff; overflow: hidden; }
        .bar { display: flex; align-items: center; gap: 8px; background: #000; color: #fff; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; padding: 7px 11px; }
        .bar { overflow-wrap: anywhere; }
        .mk { width: 8px; height: 8px; background: var(--synthetic-green); flex: none; }
        /* fixed layout + wrapping keeps long URLs/commands inside the card */
        table { width: 100%; border-collapse: collapse; table-layout: fixed; }
        td { padding: 4px 11px; vertical-align: top; font-family: var(--font-mono); font-size: 11px; line-height: 1.5; color: #26262b; border-bottom: 1px solid #F1F1ED; overflow-wrap: anywhere; word-break: break-word; }
        tr:last-child td { border-bottom: none; }
        td.k { color: #0B7D29; font-weight: 600; width: 34%; font-size: 10.5px; letter-spacing: .01em; }
        code { font-family: var(--font-mono); font-size: 10px; background: #ECFBEE; color: #0B7A26; padding: 1px 4px; overflow-wrap: anywhere; word-break: break-word; }
        a { color: #0B7A26; overflow-wrap: anywhere; }

        /* ---- footer ---- */
        .ft { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-top: 18px; font-family: var(--font-mono); font-size: 10.5px; color: rgba(255, 255, 255, .5); }
        .ft a { color: var(--synthetic-green); text-decoration: none; }
        .ft .dots { display: flex; gap: 3px; }
        .ft .dots i { width: 5px; height: 5px; background: var(--synthetic-green); display: block; opacity: .5; }

        /* JetBrains Air theme, based on air.dev */
        body.theme-air {
            --air-bg: #292b2d;
            --air-panel: #202325;
            --air-panel-2: #181b1d;
            --air-cyan: #00b2d6;
            --air-teal: #2f9f83;
            --air-mint: #6ee7c8;
            --air-border: rgba(255, 255, 255, .13);
            --air-text: #fff;
            --air-muted: rgba(255, 255, 255, .72);
            --synthetic-green: var(--air-cyan);
            --font-sans: 'Modul Air', Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }
        .theme-air .pg {
            min-height: 100vh;
            background:
                radial-gradient(circle at 18% 10%, rgba(0, 178, 214, .42), transparent 34%),
                radial-gradient(circle at 82% 18%, rgba(47, 159, 131, .34), transparent 31%),
                linear-gradient(180deg, rgba(0, 178, 214, .28) 0%, rgba(0, 178, 214, 0) 34%),
                var(--air-bg);
            background-size: auto;
            padding: 46px 40px 60px;
            color: var(--air-text);
        }
        .theme-air .frame { max-width: 1388px; }
        .theme-air .hd {
            position: relative;
            overflow: hidden;
            align-items: center;
            border: 1px solid var(--air-border);
            border-radius: 22px;
            padding: 24px 26px;
            margin-bottom: 18px;
            background:
                linear-gradient(135deg, rgba(255, 255, 255, .09), rgba(255, 255, 255, .025)),
                rgba(24, 27, 29, .72);
            box-shadow: 0 24px 80px rgba(0, 0, 0, .32);
        }
        .theme-air .hd::after {
            content: "";
            position: absolute;
            inset: auto -10% -90px 42%;
            height: 170px;
            background: radial-gradient(circle, rgba(0, 178, 214, .38), transparent 68%);
            pointer-events: none;
        }
        .theme-air .hd-l,
        .theme-air .hd-r { position: relative; z-index: 1; }
        .theme-air .mark {
            width: 128px;
            height: auto;
            min-height: 56px;
            padding: 12px 14px;
            border: 1px solid rgba(255, 255, 255, .18);
            border-radius: 14px;
            background: rgba(255, 255, 255, .08);
            object-fit: contain;
            filter: drop-shadow(0 0 22px rgba(0, 178, 214, .38));
        }
        .theme-air .eyebrow {
            color: var(--air-mint);
            letter-spacing: .16em;
        }
        .theme-air .title {
            max-width: 900px;
            font-family: var(--font-sans);
            font-size: 48px;
            font-weight: 650;
            letter-spacing: -.035em;
        }
        .theme-air .title .hl,
        .theme-air .title .hl2 {
            color: #fff;
            text-shadow: 0 0 34px rgba(0, 178, 214, .55);
        }
        .theme-air .sub {
            color: var(--air-muted);
            max-width: 690px;
        }
        .theme-air .ver {
            color: #061014;
            background: linear-gradient(90deg, var(--air-cyan), var(--air-mint));
            border-radius: 999px;
            padding: 6px 13px;
        }
        .theme-air .stamp { color: rgba(255, 255, 255, .62); }
        .theme-air .docs {
            color: #fff;
            border-color: rgba(255, 255, 255, .2);
            border-radius: 999px;
            background: rgba(255, 255, 255, .07);
        }
        .theme-air .docs:hover {
            color: #061014;
            background: var(--air-cyan);
            border-color: var(--air-cyan);
        }
        .theme-air .sheet {
            border: 1px solid var(--air-border);
            border-radius: 22px;
            background:
                linear-gradient(180deg, rgba(255, 255, 255, .065), rgba(255, 255, 255, .025)),
                rgba(24, 27, 29, .78);
            box-shadow: 0 28px 90px rgba(0, 0, 0, .34);
        }
        .theme-air .card {
            border-color: rgba(255, 255, 255, .12);
            border-radius: 14px;
            background: rgba(32, 35, 37, .92);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .06);
        }
        .theme-air .bar {
            background: linear-gradient(90deg, rgba(0, 178, 214, .25), rgba(47, 159, 131, .12));
            color: #fff;
            border-bottom: 1px solid rgba(255, 255, 255, .1);
        }
        .theme-air .mk {
            border-radius: 999px;
            background: var(--air-cyan);
            box-shadow: 0 0 18px rgba(0, 178, 214, .8);
        }
        .theme-air td {
            color: rgba(255, 255, 255, .84);
            border-bottom-color: rgba(255, 255, 255, .08);
        }
        .theme-air td.k {
            color: var(--air-mint);
        }
        .theme-air code {
            color: #9af6df;
            background: rgba(0, 178, 214, .14);
            border: 1px solid rgba(0, 178, 214, .18);
            border-radius: 5px;
        }
        .theme-air a { color: #7ee7ff; }
        .theme-air .ft { color: rgba(255, 255, 255, .55); }
        .theme-air .ft a { color: #7ee7ff; }
        .theme-air .ft .dots i {
            border-radius: 999px;
            background: var(--air-cyan);
        }
    </style>
</head>
<body class="theme-{{ productId | default('default') }}">
    <div class="pg">
        <div class="frame">
            <div class="hd">
                <div class="hd-l">
{%- if productId == 'air' %}
                    <img class="mark" src="https://air.dev/assets/air-logo-LD7eQ3qw.svg" alt="JetBrains Air">
{%- else %}
                    <svg class="mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 233.986 234" fill="var(--synthetic-green)" aria-hidden="true">
                        <path transform="translate(77.779 0)" d="M 77.852 0 L 0 0 L 0 78.036 L 77.852 78.036 L 77.852 0 Z"></path>
                        <path transform="translate(0 77.976)" d="M 77.851 0 L 0 0 L 0 78.036 L 77.851 78.036 L 77.851 0 Z"></path>
                        <path transform="translate(78.347 77.927)" d="M 77.788 0.064 L 155.64 0.064 L 155.64 13.07 C 155.64 104.112 116.714 156.073 12.975 156.073 L 0 156.073 L 0 78.037 L 12.975 78.037 C 58.357 78.037 77.851 58.559 77.851 13.006 L 77.851 0 L 77.788 0.064 Z"></path>
                    </svg>
{%- endif %}
                    <div>
                        <p class="eyebrow">{{ brandName | safe }}</p>
                        <h1 class="title">{{ title | safe }}</h1>
                        <p class="sub">{{ brandSub | safe }}</p>
                    </div>
                </div>
                <div class="hd-r">
                    <span class="ver">{{ badge | safe }}</span>
{%- if generatedNote %}
                    <span class="stamp">{{ generatedNote }}</span>
{%- endif %}
                    <a class="docs" href="{{ docsUrl }}" target="_blank" rel="noopener">{{ docsLabel | safe }}</a>
                </div>
            </div>

            <div class="sheet">
                <div class="grid">
{%- for section in sections %}
                    <div class="card">
                        <div class="bar"><span class="mk"></span>{{ section.title | safe }}</div>
                        <table>
                            <tbody>
{%- for row in section.rows %}
                            <tr><td class="k">{{ row.label | safe }}</td><td>{{ row.value | safe }}</td></tr>
{%- endfor %}
                            </tbody>
                        </table>
                    </div>
{%- endfor %}
                </div>
            </div>

            <div class="ft">
                <span>{{ displayName }} by JetBrains · auto-generated from public docs{% if generatedNote %} · {{ generatedNote }}{% endif %}. Details are version-sensitive — <a href="{{ docsUrl }}" target="_blank" rel="noopener">verify current docs</a> before production rollout.</span>
                <span class="dots"><i></i><i></i><i></i><i></i><i></i></span>
            </div>
        </div>
    </div>
</body>
</html>
